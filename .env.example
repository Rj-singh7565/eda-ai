# Groq LLM API Key (Required)
GROQ_API_KEY=your_groq_api_key

# Pinecone Vector DB (Required)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=eda-assistant

# Production Database (Optional - Defaults to local SQLite eda_assistant.db if omitted)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Object Storage (Optional - Defaults to local folder storage if omitted)
# STORAGE_TYPE=local # 'local', 's3', or 'supabase'
# S3_BUCKET=your_s3_bucket_name
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Supabase Storage (Optional)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_key
# SUPABASE_STORAGE_BUCKET=documents

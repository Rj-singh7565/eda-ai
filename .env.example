# ==============================================================================
# AI-Based EDA Assistant — Backend Environment Variables Configuration
# ==============================================================================

# ── 1. Groq LLM API (Required) ────────────────────────────────────────────────
# API key obtained from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# LLM Model ID on Groq (default: openai/gpt-oss-120b)
LLM_MODEL=openai/gpt-oss-120b

# ── 2. Pinecone Vector Database (Required) ────────────────────────────────────
# API key obtained from https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
# Name of the Pinecone serverless index (e.g., aieda)
PINECONE_INDEX_NAME=aieda

# ── 3. Embeddings Configuration ───────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# ── 4. Server & Port Configuration (Render automatically sets PORT) ───────────
PORT=8000

# ── 5. CORS & Frontend Connectivity (Production on Vercel) ────────────────────
# The public production URL of your deployed Vercel frontend
FRONTEND_URL=https://your-frontend.vercel.app

# Comma-separated list of allowed origins (localhost is enabled by default)
CORS_ORIGINS=https://your-frontend.vercel.app

# ── 6. Database Configuration (Optional) ──────────────────────────────────────
# If omitted, defaults to local SQLite database (eda_assistant.db).
# For permanent multi-instance Render deployments, supply a PostgreSQL URL:
# DATABASE_URL=postgresql://username:password@host:5432/database_name

# ── 7. Object Storage Configuration (Optional) ────────────────────────────────
# Storage backend: 'local' (default), 's3', or 'supabase'
STORAGE_TYPE=local

# AWS S3 / Cloudflare R2 / S3-compatible (Optional)
# S3_BUCKET=your_s3_bucket_name
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Supabase Storage (Optional)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_key
# SUPABASE_STORAGE_BUCKET=documents
